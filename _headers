# Security + caching headers (read automatically by Netlify; ignored by GitHub Pages)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self' https://formsubmit.co; form-action 'self' https://formsubmit.co mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

/_images/*
  Cache-Control: public, max-age=31536000, immutable
/css_assets/*
  Cache-Control: public, max-age=604800
/js_assets/*
  Cache-Control: public, max-age=604800
